{
  // Browser code under web/: DOM available. web/shared/lib and the typed pure dirs (fidice domain,
  // bots and net/protocol, the gin engine, the gin protocol.ts and scorer maths) are checked by both
  // projects on purpose: the pure project is the guard, and a composite project must list every .ts
  // its edges import. TypeScript only: `allowJs` carried the de-bundled fidice .js modules while
  // they were ported (docs/MIGRATION.md steps 6-9) and left in step 15; test/ratchet.test.ts
  // asserts that no .js file exists under web/.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": []
  },
  // test/shared holds the replay driver and the test scaffolding the engine tests beside the
  // engines import (dry-round-2.md F3, F4); a composite project lists every file it compiles.
  "include": ["web/**/*.ts", "test/shared/**/*.ts"]
}
