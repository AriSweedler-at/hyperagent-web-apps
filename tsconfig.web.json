{
  // Browser code under web/: DOM available. The game-owned pure dirs still in JavaScript are
  // excluded because tsconfig.pure.json owns them. web/shared/lib and the typed pure dirs (fidice
  // domain, bots and net/protocol since docs/MIGRATION.md step 8) are checked by both projects on
  // purpose: the pure project is the guard, and a composite project must list every .ts its edges
  // import. Migration only: `allowJs` lets de-bundled .js modules type-check as they are ported;
  // step 15 removes it (a ratchet test keeps the .js count from growing).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["web/**/*.ts", "web/**/*.js"],
  "exclude": ["web/games/*/src/engine/**", "web/games/*/src/protocol.ts"]
}
