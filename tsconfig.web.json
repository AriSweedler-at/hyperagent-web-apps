{
  // Browser code under web/: DOM available. The game-owned pure dirs are excluded because
  // tsconfig.pure.json owns them. web/shared/lib is checked by both projects on purpose: the pure
  // project is the guard, and keeping it here means this project never has zero inputs.
  // Migration only: `allowJs` lets de-bundled .js modules type-check as they are ported; step 15
  // removes it (a ratchet test keeps the .js count from growing).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["web/**/*.ts", "web/**/*.js"],
  "exclude": [
    "web/games/*/src/engine/**",
    "web/games/*/src/domain/**",
    "web/games/*/src/bots/**",
    "web/games/*/src/protocol.ts"
  ]
}
