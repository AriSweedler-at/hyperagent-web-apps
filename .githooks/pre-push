#!/bin/sh
# Run the same checks as the CI job "check" (typecheck, lint, unit tests) before anything leaves
# this machine. Installed by `npm run hooks`; see docs/ARCHITECTURE.md "Git hooks".
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ ! -d node_modules ]; then
  echo "pre-push: node_modules is missing; run: npm ci" >&2
  exit 1
fi
exec npm run check
