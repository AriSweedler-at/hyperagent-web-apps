{
  // Pure layers: no DOM lib and no node types, so `window`, `document`, `HTMLElement` and `process`
  // are unnameable here by the compiler (docs/ARCHITECTURE.md "Module boundaries and contracts").
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": []
  },
  "include": [
    "web/shared/lib/**/*.ts",
    "web/shared/ui/**/*.ts",
    "web/games/*/src/engine/**/*.ts",
    "web/games/*/src/domain/**/*.ts",
    "web/games/*/src/bots/**/*.ts",
    "web/games/*/src/protocol.ts",
    "web/games/*/src/net/protocol.ts",
    "web/games/*/src/scorer/**/*.ts"
  ],
  // The Score Counter's screen (docs/MIGRATION.md step 12) is an edge, and its test runs on the
  // DOM page fake; eslint.config.js spells the same carve-out as `scorer/!(main|*.test).ts`. The
  // shared shell's painters and binders (docs/design/shared-shell.md §4.4) write the document
  // through web/shared/edge/dom.ts and stay out with their tests the same way (eslint.config.js
  // `web/shared/ui/!(shellPaint|curtain|toast|home|keyed).ts`); tsconfig.web.json compiles them.
  "exclude": [
    "web/games/*/src/scorer/main*.ts",
    "web/shared/ui/shellPaint*.ts",
    "web/shared/ui/curtain*.ts",
    "web/shared/ui/toast*.ts",
    "web/shared/ui/home*.ts",
    "web/shared/ui/keyed*.ts"
  ]
}
