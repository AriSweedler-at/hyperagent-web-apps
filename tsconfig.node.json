{
  // Node-side TypeScript: config files, tools/ (run with `node --experimental-strip-types`), the
  // test/ tree and Playwright specs. No DOM. web/shared/lib is listed because test/ imports it
  // (seeded rng for the parity suites) and a composite project must list every file it compiles;
  // tsconfig.pure.json remains the guard for that directory, as in tsconfig.web.json. The three edge
  // modules listed are written against structural types (no DOM lib) because test/parity runs the
  // ICE loader beside the legacy IIFE in node; tsconfig.web.json still owns web/shared/edge. The
  // transport edge, web/shared/net (the two-seat sessions both games' net/ wrap,
  // docs/design/shared-shell.md A1) and the fidice pure core plus net/ are listed for the same reason since
  // docs/MIGRATION.md step 9: test/parity/fidice.sessions.test.ts drives the typed sessions over
  // transport.fake.ts beside the legacy classes (tsconfig.web.json still owns those files too).
  // dom.fake.ts and the DOM-free view modules (types, ui, scenarios) are listed for
  // test/parity/fidice.view.test.ts, which renders the typed and the legacy view of every
  // catalogued state into the fake DOM; the screens themselves (DOM types) are imported there
  // dynamically, as the pure modules are.
  // The gin engine is listed since docs/MIGRATION.md step 10: test/parity runs it beside the
  // legacy fixture as the `current` leg (tsconfig.pure.json remains its guard); since step 11 the
  // whole gin src/ tree is (protocol, storage, the string-producing ui/ and scorer/ helpers, all
  // DOM-free by design) with web/shared/edge/storage.ts and, since the shared-shell extraction
  // (docs/design/shared-shell.md §5 A3), web/shared/edge/prefs.ts, which both games' storage.ts
  // build their readers and writers from, for the codec, storage and string-golden parity suites;
  // since step 12 web/shared/edge/fx.ts is listed too (the gin fx.ts wraps it, all structural
  // types), with sound.ts and cuePlayer.ts beside it (the shared player both games' fx.ts wrap,
  // docs/design/shared-shell.md §5 A4), and the DOM modules (ui/render.ts, ui/home.ts, ui/local.ts,
  // the hand's dragger.ts and flip.ts) are excluded below, by globs over web/games/*/src/ui where
  // both games name a module the same way (docs/design/shared-shell.md §5 A5).
  // infra/games-proxy/**/*.ts is the games.sweedler.com Worker (TypeScript since step 15; wrangler
  // bundles it as is) with its table tests: tools/proxy-dev.ts runs its default export and the dist
  // guards import mapPath. It uses the WHATWG globals @types/node declares (Request, Response,
  // Headers, URL, fetch), the same interfaces Cloudflare provides.
  // The backgammon src/ tree is listed as gin's is (docs/design/backgammon-board.md §6):
  // test/dist/backgammon-grid.test.ts imports ui/board/layout.ts, which reaches the engine, and
  // the e2e fixtures take the engine's types; its DOM modules (the painters, the page fake, the
  // flight and drag helpers over web/shared/edge/dom.ts) are excluded below by the same globs. Its
  // protocol.test.ts reads the wire goldens through Vite's `?raw` import, so the one declaration
  // tsconfig.web.json relies on (web/raw-imports.d.ts) is listed here too.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "vitest.config.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "tools/**/*.ts",
    "test/**/*.ts",
    "e2e/**/*.ts",
    "web/shared/lib/**/*.ts",
    "web/shared/ui/**/*.ts",
    // The shell markup renderer and the shell games' page.ts (dry-round-2.md G2): tools/shell-markup.ts
    // composes each web/games/<g>/index.html from them and test/dist/shell-markup.test.ts pins it.
    "web/shared/markup/**/*.ts",
    "web/games/*/page.ts",
    "web/shared/edge/clock.ts",
    "web/shared/edge/clock.fake.ts",
    "web/shared/edge/ice.ts",
    "web/shared/edge/transport.ts",
    "web/shared/edge/transport.fake.ts",
    "web/shared/edge/peer.ts",
    "web/shared/net/**/*.ts",
    "web/shared/edge/transport.contract.log.ts",
    "web/shared/edge/dom.fake.ts",
    "web/games/fidice/src/domain/**/*.ts",
    "web/games/fidice/src/bots/**/*.ts",
    "web/games/fidice/src/net/**/*.ts",
    "web/games/fidice/src/view/types.ts",
    "web/games/fidice/src/view/ui.ts",
    "web/games/fidice/src/view/scenarios.ts",
    "web/games/gin-rummy/src/**/*.ts",
    "web/games/backgammon/src/**/*.ts",
    "web/raw-imports.d.ts",
    "web/shared/edge/storage.ts",
    "web/shared/edge/prefs.ts",
    "web/shared/edge/fx.ts",
    "web/shared/edge/sound.ts",
    "web/shared/edge/cuePlayer.ts",
    "infra/games-proxy/**/*.ts"
  ],
  // The paint and wiring of both games (ui/{render,home,local}.ts, the page fake, the drag helper
  // under ui/hand or ui/board; step 12, backgammon-board.md §6) are written against the DOM edge
  // and stay out with their tests, as do gin's scorer/main.ts, the hand's flip, the board's flight
  // and the stories page (stories/boot.ts paints; its catalogue is DOM-free and stays in,
  // e2e/gin-stories.spec.ts imports it). One glob per module name the games share: fidice has no
  // src/ui, so the globs reach only the two. The shared shell's painters and binders
  // (web/shared/ui/{shellPaint,curtain,toast,home}.ts, docs/design/shared-shell.md §4.4; keyed.ts,
  // dry-round-2.md D1) are DOM modules too and stay out with their tests; ids.ts (a list) stays in for test/dist/shell-ids.test.ts.
  "exclude": [
    "test/fixtures/legacy/*.cjs",
    "web/shared/ui/shellPaint*.ts",
    "web/shared/ui/curtain*.ts",
    "web/shared/ui/toast*.ts",
    "web/shared/ui/home*.ts",
    "web/shared/ui/keyed*.ts",
    "web/games/*/src/ui/render*.ts",
    "web/games/*/src/ui/home*.ts",
    "web/games/*/src/ui/local*.ts",
    "web/games/*/src/ui/page.fake.ts",
    "web/games/*/src/ui/*/dragger*.ts",
    "web/games/gin-rummy/src/ui/hand/flip*.ts",
    "web/games/gin-rummy/src/scorer/main*.ts",
    "web/games/gin-rummy/src/stories/boot.ts",
    "web/games/gin-rummy/src/stories/catalogue.test.ts",
    "web/games/backgammon/src/ui/board/fly*.ts"
  ]
}
