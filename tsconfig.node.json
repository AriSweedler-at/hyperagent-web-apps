{
  // Node-side TypeScript: config files, tools/ (run with `node --experimental-strip-types`), the
  // test/ tree and Playwright specs. No DOM. web/shared/lib is listed because test/ imports it
  // (seeded rng for the parity suites) and a composite project must list every file it compiles;
  // tsconfig.pure.json remains the guard for that directory, as in tsconfig.web.json. The three edge
  // modules listed are written against structural types (no DOM lib) because test/parity runs the
  // ICE loader beside the legacy IIFE in node; tsconfig.web.json still owns web/shared/edge.
  // infra/games-proxy/worker.js is listed (allowJs, its JSDoc supplies the types) because
  // tools/proxy-dev.ts runs its default export; checkJs stays off: the JS config lints it.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "vitest.config.ts",
    "vitest.dist.config.ts",
    "vitest.integration.config.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "tools/**/*.ts",
    "test/**/*.ts",
    "e2e/**/*.ts",
    "web/shared/lib/**/*.ts",
    "web/shared/edge/clock.ts",
    "web/shared/edge/clock.fake.ts",
    "web/shared/edge/ice.ts",
    "web/shared/edge/transport.contract.log.ts",
    "infra/games-proxy/worker.js"
  ],
  "exclude": ["test/fixtures/legacy/*.cjs"]
}
