{
  "name": "hyperagent-web-apps",
  "private": true,
  "type": "module",
  "description": "Ari's browser games (Gin Rummy, Fidice, Sheshbesh backgammon) with their Cloudflare Workers, served by GitHub Pages",
  "scripts": {
    "build": "vite build",
    "preview": "npm run build && npm run serve",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:shared": "VITEST_SUITE=shared vitest run --project shared",
    "test:shared-integration": "VITEST_SUITE=shared-integration vitest run --project shared-integration --reporter=verbose",
    "test:gin": "VITEST_SUITE=gin vitest run --project gin",
    "test:fidice": "VITEST_SUITE=fidice vitest run --project fidice",
    "test:backgammon": "VITEST_SUITE=backgammon vitest run --project backgammon",
    "test:briscola": "VITEST_SUITE=briscola vitest run --project briscola",
    "test:site": "npm run build && VITEST_SUITE=site vitest run --project site",
    "test:harness": "VITEST_SUITE=harness vitest run --project harness",
    "test:dist": "npm run test:site",
    "test:integration": "npm run test:shared-integration",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:gin": "E2E_SUITE=gin npm run test:e2e",
    "test:e2e:fidice": "E2E_SUITE=fidice npm run test:e2e",
    "test:e2e:backgammon": "E2E_SUITE=backgammon npm run test:e2e",
    "test:e2e:site": "E2E_SUITE=site npm run test:e2e",
    "test:deployed": "E2E_TARGET=deployed npm run test:e2e -- --grep \"@online|@relay\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:site",
    "check:affected": "npm run typecheck && npm run lint && npm run test:affected",
    "test:affected": "node --experimental-strip-types tools/ci/run-affected.ts",
    "affected": "node --experimental-strip-types tools/ci/affected.ts",
    "serve": "node --experimental-strip-types tools/serve-dist.ts --root dist --base /hyperagent-web-apps/ --alias e2e-ice.json=e2e/fixtures/e2e-ice.json",
    "proxy:dev": "node --experimental-strip-types tools/proxy-dev.ts --upstream http://127.0.0.1:4173",
    "fixtures:legacy": "node --experimental-strip-types tools/legacy/extract-gin-engine.ts && node --experimental-strip-types tools/legacy/extract-fidice-core.ts && node --experimental-strip-types tools/legacy/extract-gin-ui.ts",
    "fixtures:gin-wire": "node --experimental-strip-types tools/legacy/record-gin-wire.ts",
    "fixtures:gin-storage": "node --experimental-strip-types tools/legacy/capture-gin-storage.ts",
    "debundle:fidice": "node --experimental-strip-types tools/legacy/debundle-fidice.ts",
    "hooks": "git config core.hooksPath .githooks",
    "hooks:verify": "sh tools/hooks-verify.sh",
    "prepare": "npm run hooks"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "peerjs": "1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-functional": "10.0.0",
    "eslint-plugin-import-x": "4.17.1",
    "peer": "1.0.2",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
